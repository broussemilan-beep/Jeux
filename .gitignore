# §12.3 : exclut tout contenu reconstructible.
.godot/
*.translation

# EXCEPTION (docs/worklog.md, build de test tactile web) :
# export_presets.cfg encode des choix non triviaux à reproduire pour le
# preset "Web" (thread_support=false, obligatoire pour tourner sur
# GitHub Pages qui ne sert pas les en-têtes COOP/COEP) — le garder
# versionné évite de les redécouvrir à chaque re-export.

# Caches d'atlas temporaires (scripts/build_atlas.py écrira ici plus tard).
assets/staging/*
!assets/staging/.gitkeep

# Sorties de capture locales non versionnées — seules les captures
# APPROUVÉES (référencées dans data/labels/quality_labels.jsonl) sont
# commitées, jamais un dossier de sortie brut (§13.3).
/captures_local/

# Clés/secrets — dépôt public, une clé commitée est immédiatement
# exploitable. La config MCP Meshy (clé incluse) vit en scope "local"
# de Claude Code (~/.claude.json, hors du dépôt), jamais ici — ce
# garde-fou reste au cas où un futur .env local serait créé par erreur.
.env
.env.*
*.secret


# Bake-off Voie C — sorties Meshy AI brutes (GLB/FBX, plusieurs MB, non
# suivies tant que Milan n'a pas validé cette voie) : mêmes raisons que
# /captures_local/ (§13.3) — pas un dossier de sortie brut committé.
/experiments/bakeoff_voie_c/meshy_output/
