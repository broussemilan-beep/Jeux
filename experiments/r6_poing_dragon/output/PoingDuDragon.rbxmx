					{ type = "particules", nom = "etoile", t0 = 0.0, ancre = { pos = { 0.4, 0.2, -9.3 }, dir = { 0, -1, 0 }, coup = { 0, -1, 0 } }, texture = "etoile4", emit = 1, lifetime = { 0.0333, 0.0333 }, size = {
							{ 0.0, 4.42, 0.0 },
