		{ frame = 587, kind = "studio", name = "atterrissage", recette = { nom = "dragon_atterrissage", titre = "dragon_atterrissage", duree = 0.55, graine = 5, sons = {
					{ son = "impact_lourd", t0 = 0.0, volume = 0.6, hauteur = 1.2, impact = true, duree = 0.6 },
