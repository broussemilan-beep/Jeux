					{ type = "particules", nom = "anneau", t0 = 0.0, ancre = { pos = { 0.4, 0.2, -9.3 }, dir = { 0, -1, 0 }, coup = { 0, -1, 0 } }, texture = "anneau", emit = 1, lifetime = { 0.12, 0.12 }, size = {
							{ 0.0, 0.78, 0.0 },
