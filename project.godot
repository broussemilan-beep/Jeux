; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rank Zero"
config/features=PackedStringArray("4.3", "Mobile")
run/main_scene="res://scenes/gameplay/outpost.tscn"

[autoload]

; RunState EN PREMIER — H4 (mandat §6, GDD §20 "boucle de run") : Player lit
; RunState.player_stats dans son propre _ready() (voir player.gd), donc
; RunState doit exister avant que la scène courante instancie un Player.
; Aucune dépendance sur les autres autoloads.
RunState="*res://src/system/run_state.gd"
; CombatFeedback EN PREMIER — bug réel trouvé en câblant C2
; (docs/worklog.md) : les autoloads et les nœuds de scène réguliers
; consultent tous CombatFeedback.is_frozen() en tête de leur propre
; _physics_process(), mais Godot traite les autoloads dans l'ordre de
; cette liste PUIS les nœuds de scène. Avec CombatFeedback en dernier,
; sur le tick où le gel passe de 1 à 0, VfxRecipeRegistry/VfxDirector
; (traités AVANT CombatFeedback ce tick) lisaient encore l'ancienne
; valeur (gelé) et sautaient un tick de plus, alors que les nœuds de
; scène (Player, GueuleVide — traités APRÈS tous les autoloads, donc
; après le décompte de CombatFeedback CE MÊME tick) lisaient déjà la
; valeur fraîche (dégelé) et avançaient — un dé-sync asymétrique d'1
; tick à chaque hit-stop entre "ce qu'une entité fait" et "ce que sa
; propre recette VFX croit avoir fait". Invisible tant qu'aucun test ne
; comparait les deux horloges d'une même entité sur toute sa durée de
; vie ; découvert via gueule_vide_owner_death_cancels_degradable_layer
; (le shardBurst d'un run déjà terminé selon la créature spawnait quand
; même, 1 tick "en retard" côté registry). Fixé en plaçant CombatFeedback
; en tête : son décompte est déjà à jour avant que QUICONQUE d'autre
; (autoload ou nœud de scène) ne lise is_frozen() ce tick-là.
CombatFeedback="*res://src/gameplay/combat_feedback.gd"
; VfxBudget avant VfxDirector — §8.2 du doc : "VfxDirector.spawn(...)"
; est appelé comme un singleton, jamais instancié à la main ; le
; director consulte le budget dès son premier spawn.
VfxBudget="*res://src/vfx/vfx_budget.gd"
VfxDirector="*res://src/vfx/vfx_director.gd"
; VfxRecipeRegistry après VfxDirector : elle appelle VfxDirector.spawn()
; pour chaque couche résolue, jamais l'inverse.
VfxRecipeRegistry="*res://src/vfx/vfx_recipe_registry.gd"
; HitResponse après VfxDirector/VfxBudget (utilise VfxDirector.spawn pour
; le shardBurst de mort et VfxBudget pour le décal) — mandat production
; v1 §4.
HitResponse="*res://src/gameplay/hit_response.gd"
; CameraDirector n'a aucune dépendance sur les autres autoloads (il ne
; consulte que CombatFeedback.is_frozen(), déjà en tête) — ordre non
; critique, placé en dernier par simplicité (mandat production v1 §4, J2).
CameraDirector="*res://src/gameplay/camera_director.gd"
; Sfx (Phase 2.1, MANDAT SUITE v2) — aucune dépendance sur les autres
; autoloads (juste un pool d'AudioStreamPlayer), ordre non critique.
Sfx="*res://src/gameplay/sfx.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

; §0 : résolution native 640×360, upscale entier uniquement.
window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=0
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation="landscape"

[input]

; Phase 1.4 : action "attack" pour le combo léger — touche espace au
; clavier + TouchScreenButton dédié (ButtonAttack, touch_controls.tscn),
; câblé via son propre `action = "attack"`, jamais via cette liste
; d'events. Phase R1 (retour croisé Gemini/ChatGPT sur clip réel,
; MANDAT SUITE v2) : le binding InputEventMouseButton générique
; (button_mask=1, aucune position/zone restreinte) hérité de la Phase
; 1.4 faisait qu'un SIMPLE CLIC/TOUCHER N'IMPORTE OÙ À L'ÉCRAN
; déclenchait une attaque sur le build web tactile — un bouton
; InputEventMouseButton sans zone n'est jamais limité à un widget
; précis, contrairement à un TouchScreenButton (qui a sa propre
; CollisionShape2D). Retiré : seul le clavier + le bouton tactile
; dédié restent. Vérifié : aucune autre action (power1-4, dash, dodge,
; character_screen) n'a de binding InputEventMouseButton — "attack"
; était un cas isolé.
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

; Invocation "Gueule Vide" (pouvoir INVOCATEUR) — touche E, premier
; emplacement de pouvoir ("power1"), même discipline que "attack" :
; juste ce qu'il faut pour un déclenchement just_pressed testable en
; headless, pas de remap/tactile (hors scope Phase 1).
power1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

