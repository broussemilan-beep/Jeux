; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rank Zero"
config/features=PackedStringArray("4.3", "Mobile")
run/main_scene="res://scenes/gameplay/test_arena.tscn"

[autoload]

; Autoloads globaux — §8.2 du doc : "VfxDirector.spawn(...)" est appelé
; comme un singleton, jamais instancié à la main. VfxBudget avant
; VfxDirector : le director consulte le budget dès son premier spawn.
VfxBudget="*res://src/vfx/vfx_budget.gd"
VfxDirector="*res://src/vfx/vfx_director.gd"
; VfxRecipeRegistry après VfxDirector : elle appelle VfxDirector.spawn()
; pour chaque couche résolue, jamais l'inverse.
VfxRecipeRegistry="*res://src/vfx/vfx_recipe_registry.gd"

[display]

; §0 : résolution native 640×360, upscale entier uniquement.
window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=0
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation="landscape"

[input]

; Phase 1.4 : action "attack" pour le combo léger — pas d'exigence de
; contrôles réels dans le mandat Phase 1 (remap, tactile, etc. hors
; scope, voir player.gd), une seule touche + clic gauche suffisent pour
; une tranche verticale testée en headless.
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

; Invocation "Gueule Vide" (pouvoir INVOCATEUR) — touche E, premier
; emplacement de pouvoir ("power1"), même discipline que "attack" :
; juste ce qu'il faut pour un déclenchement just_pressed testable en
; headless, pas de remap/tactile (hors scope Phase 1).
power1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

; Build de test tactile (feel du combo/dash/Gueule Vide sur iPhone,
; voir docs/worklog.md) — touche Shift gauche au clavier, bouton
; tactile dash côté web/mobile. Câblée dans Player.play_dash().
dash={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194325,"key_label":0,"unicode":0,"location":1,"echo":false,"script":null)
]
}

[physics]

; §0 : "60 ticks/s. Toutes les durées d'animation/VFX s'expriment en
; ticks (1 tick ≈ 16,6 ms)." physics_process tourne à ce pas fixe —
; c'est notre horloge de tick, jamais _process (variable).
common/physics_ticks_per_second=60

; Trouvé pendant la validation Phase 0 (docs/worklog.md) : la valeur par
; défaut (8) autorise un RATTRAPAGE en rafale — après un retard réel
; (démarrage, compilation shader, hoquet thermique §11.3), le moteur peut
; exécuter plusieurs ticks physiques dans UNE SEULE frame rendue pour
; rattraper le temps perdu. Un impactFlashFrame de 1-2 ticks (§4) peut
; alors naître et mourir entre deux frames réellement dessinées — un VFX
; qui disparaît silencieusement, exactement la classe de bug que §11.1
; dénonce pour les particules invisibles. Plafonné à 1 : la simulation
; ralentit plutôt que de sauter des ticks — jamais un état court-vécu
; escamoté. Coût accepté : ralentissement perçu sous charge extrême
; plutôt qu'un saut de simulation invisible ; cohérent avec l'exigence
; de déterminisme du mandat (§13.4 "seed fixe → même sortie").
common/max_physics_steps_per_frame=1

[input_devices]

; Build de test tactile (docs/worklog.md) : permet de vérifier les
; TouchScreenButton/joystick virtuel depuis un navigateur desktop avant
; l'export réel sur iPhone. Sans effet sur le tactile natif (le vrai
; test se fait sur l'appareil de Milan).
pointing/emulate_touch_from_mouse=true

[rendering]

; §0 et §11.1 : renderer Mobile fixé dès le premier commit — le
; Compatibility ne supporte pas les GPUParticles (silencieux, sans
; erreur). Jamais Forward+ (le mandat ne le demande pas, plus lourd).
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

; §0 : filtre Nearest, mipmaps désactivés (pixel art net, budget mémoire
; mobile). Filtre par défaut au niveau projet ; chaque import de texture
; doit aussi désactiver mipmaps individuellement (§11.2) — pas de
; réglage projet global pour ça, c'est par asset.
textures/canvas_textures/default_texture_filter=0

; §11.2 : compression ETC2 (Android) / ASTC (iOS) à l'import.
textures/vram_compression/import_etc2_astc=true
