; Écran personnage (H5, GDD §17 : "NAME / RANK / LEVEL / FOR / AGI / INT /
; VIT / CLASS / SKILLS / EQUIPMENT") — touche Tab au clavier, bouton
; tactile dédié ("PERSO"). Bascule ouvert/fermé sur chaque pression,
; câblée dans CharacterScreen (src/ui/character_screen.gd), pas
; player.gd : cet écran n'affecte aucune timeline d'action du joueur.
character_screen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194306,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

; §0 : "60 ticks/s. Toutes les durées d'animation/VFX s'expriment en
; ticks (1 tick ≈ 16,6 ms)." physics_process tourne à ce pas fixe —
; c'est notre horloge de tick, jamais _process (variable).
common/physics_ticks_per_second=60

; Trouvé pendant la validation Phase 0 (docs/worklog.md) : la valeur par
; défaut (8) autorise un RATTRAPAGE en rafale — après un retard réel
; (démarrage, compilation shader, hoquet thermique §11.3), le moteur peut
; exécuter plusieurs ticks physiques dans UNE SEULE frame rendue pour
; rattraper le temps perdu. Un impactFlashFrame de 1-2 ticks (§4) peut
; alors naître et mourir entre deux frames réellement dessinées — un VFX
; qui disparaît silencieusement, exactement la classe de bug que §11.1
; dénonce pour les particules invisibles. Plafonné à 1 : la simulation
; ralentit plutôt que de sauter des ticks — jamais un état court-vécu
; escamoté. Coût accepté : ralentissement perçu sous charge extrême
; plutôt qu'un saut de simulation invisible ; cohérent avec l'exigence
; de déterminisme du mandat (§13.4 "seed fixe → même sortie").
common/max_physics_steps_per_frame=1

[input_devices]

; Build de test tactile (docs/worklog.md) : permet de vérifier les
; TouchScreenButton/joystick virtuel depuis un navigateur desktop avant
; l'export réel sur iPhone. Sans effet sur le tactile natif (le vrai
; test se fait sur l'appareil de Milan).
pointing/emulate_touch_from_mouse=true

[rendering]

; §0 et §11.1 : renderer Mobile fixé dès le premier commit — le
; Compatibility ne supporte pas les GPUParticles (silencieux, sans
; erreur). Jamais Forward+ (le mandat ne le demande pas, plus lourd).
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

; §0 : filtre Nearest, mipmaps désactivés (pixel art net, budget mémoire
; mobile). Filtre par défaut au niveau projet ; chaque import de texture
; doit aussi désactiver mipmaps individuellement (§11.2) — pas de
; réglage projet global pour ça, c'est par asset.
textures/canvas_textures/default_texture_filter=0

; §11.2 : compression ETC2 (Android) / ASTC (iOS) à l'import.
textures/vram_compression/import_etc2_astc=true
